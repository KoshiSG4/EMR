generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// Main user table (base model for all roles)
model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  role      Role
  createdAt DateTime @default(now())

  patients       Patient[] @relation("DoctorPatients")
  patientProfile Patient?  @relation("PatientUser")
  doctor         Doctor?
  nurse          Nurse?
  admin          Admin?
}

// Patient model (linked 1:1 to a User with role PATIENT)
model Patient {
  userId           String   @id
  fullName         String
  dateOfBirth      DateTime
  gender           String
  phone            String
  address          String
  emergencyContact String
  insuranceDetails String?

  doctorId String
  doctor   User   @relation("DoctorPatients", fields: [doctorId], references: [id])

  user User @relation("PatientUser", fields: [userId], references: [id])

  records           MedicalRecord[]
  PatientMedication PatientMedication[]
}

// Doctor model (linked 1:1 to a User with role DOCTOR)
model Doctor {
  userId            String              @id
  specialization    String
  user              User                @relation(fields: [userId], references: [id])
  PatientMedication PatientMedication[]
  medicalRecords    MedicalRecord[]
}

// Nurse model (linked 1:1 to a User with role NURSE)
model Nurse {
  userId     String @id
  shift      String
  department String
  user       User   @relation(fields: [userId], references: [id])
}

// Admin model (linked 1:1 to a User with role ADMIN)
model Admin {
  userId      String @id
  permissions String
  user        User   @relation(fields: [userId], references: [id])
}

// Medical records
model MedicalRecord {
  id        String   @id @default(uuid())
  diagnosis String
  notes     String?
  createdAt DateTime @default(now())

  patientId String
  patient   Patient @relation(fields: [patientId], references: [userId])

  doctorId String
  doctor   Doctor @relation(fields: [doctorId], references: [userId])

  prescriptions Prescription[]

  labTests LabTest[]
}

//Medication Inventory
model MedicationInventory {
  id           String           @id @default(uuid())
  name         String
  form         String
  strength     String
  batchNumber  String
  quantity     Int
  reorderLevel Int
  status       MedicationStatus @default(IN_STOCK)
  supplier     String?
  orderDate    DateTime?
  arrivalDate  DateTime?
  expiryDate   DateTime?
  reservedFor  String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  // Relations
  prescriptions Prescription[]
}

// Prescriptions
model Prescription {
  id                    String   @id @default(uuid())
  patientMedicationId   String
  medicationInventoryId String
  createdAt             DateTime @default(now())

  medicalRecord   MedicalRecord @relation(fields: [medicalRecordId], references: [id])
  medicalRecordId String

  patientMedication PatientMedication   @relation(fields: [patientMedicationId], references: [id])
  medication        MedicationInventory @relation(fields: [medicationInventoryId], references: [id])
}

// Medications linked to patients
model PatientMedication {
  id        String  @id @default(uuid())
  patientId String
  patient   Patient @relation(fields: [patientId], references: [userId])

  prescribedById   String
  prescribedByName String
  prescribedBy     Doctor @relation(fields: [prescribedById], references: [userId])

  name         String
  dosage       String
  frequency    String
  route        String
  startDate    DateTime
  endDate      DateTime?
  status       String
  instructions String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  prescriptions Prescription[]
}

//Lab Tests
model LabTest {
  id          String    @id @default(uuid())
  patientId   String
  doctorId    String
  testType    String
  status      LabStatus @default(PENDING)
  requestedAt DateTime  @default(now())
  acceptedAt  DateTime?
  result      String?
  validatedAt DateTime?
  releasedAt  DateTime?

  medicalRecord   MedicalRecord @relation(fields: [medicalRecordId], references: [id])
  medicalRecordId String
}

enum LabStatus {
  PENDING // test requested
  ACCEPTED // sample accepted
  IN_PROGRESS // being tested
  RESULT_ENTERED // results entered
  VALIDATED // validated by supervisor
  RELEASED // available to doctor/patient
}

enum MedicationStatus {
  IN_STOCK
  LOW_STOCK
  OUT_OF_STOCK
  ON_ORDER
  ARRIVED
  EXPIRED
  RESERVED
}

enum PrescriptionStatus {
  NEW
  ACTIVE
  DISCONTINUED
}

enum Role {
  ADMIN
  DOCTOR
  NURSE
  PATIENT
}
